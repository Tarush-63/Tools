import os
import random
from moviepy.editor import VideoFileClip, concatenate_videoclips, TextClip, CompositeVideoClip
import speech_recognition as sr
from gtts import gTTS
import openai

class AIVideoEditor:
    def __init__(self):
        self.source_videos = []
        self.clips = []
        self.ranking_data = []
        
    def load_videos(self, video_paths):
        """Load source videos for processing"""
        for path in video_paths:
            if os.path.exists(path):
                self.source_videos.append(VideoFileClip(path))
                print(f"Loaded: {path}")
            else:
                print(f"File not found: {path}")
    
    def analyze_content(self):
        """Analyze video content to identify key moments"""
        # This would use computer vision and audio analysis in a real implementation
        print("Analyzing video content...")
        
        # Simulate finding interesting clips (in real implementation, use ML models)
        for video in self.source_videos:
            duration = video.duration
            # Select random clips as "interesting moments" (simplified)
            clip_start = random.uniform(0, duration-5)
            clip_end = clip_start + random.uniform(2, 5)
            self.clips.append(video.subclip(clip_start, clip_end))
            
        print(f"Identified {len(self.clips)} interesting clips")
    
    def create_ranking(self, theme="top moments"):
        """Organize clips into a ranking format"""
        print(f"Creating ranking: {theme}")
        
        # Sort clips by some criteria (in real implementation, use ML ranking)
        # For demo, we'll just randomize the order
        random.shuffle(self.clips)
        
        # Add ranking labels
        for i, clip in enumerate(self.clips):
            rank = len(self.clips) - i  # Countdown format
            self.ranking_data.append({
                'clip': clip,
                'rank': rank,
                'title': f"#{rank} Amazing Moment"
            })
    
    def generate_narration(self, text):
        """Generate voiceover for the video"""
        print("Generating narration...")
        tts = gTTS(text=text, lang='en', slow=False)
        tts.save("narration.mp3")
        return "narration.mp3"
    
    def add_text_overlays(self, clip, text, position='bottom'):
        """Add text overlays to clips"""
        txt_clip = TextClip(text, fontsize=24, color='white', 
                           stroke_color='black', stroke_width=1)
        txt_clip = txt_clip.set_position(position).set_duration(clip.duration)
        return CompositeVideoClip([clip, txt_clip])
    
    def create_video(self, output_path="ranking_short.mp4"):
        """Compile all elements into final video"""
        print("Compiling final video...")
        
        # Process each ranked clip
        final_clips = []
        for item in self.ranking_data:
            # Add ranking text
            ranked_clip = self.add_text_overlays(
                item['clip'], 
                item['title'],
                position='top'
            )
            final_clips.append(ranked_clip)
        
        # Concatenate all clips
        final_video = concatenate_videoclips(final_clips, method="compose")
        
        # Add intro/outro (simplified)
        intro_text = TextClip("TOP MOMENTS COUNTDOWN", fontsize=40, color='yellow', 
                             stroke_color='black', stroke_width=2, size=final_video.size)
        intro_text = intro_text.set_duration(2).set_position('center')
        
        outro_text = TextClip("Which moment was your favorite?", fontsize=30, color='white',
                             stroke_color='black', stroke_width=1, size=final_video.size)
        outro_text = outro_text.set_duration(3).set_position('center')
        
        # Combine everything
        final_video = concatenate_videoclips([intro_text, final_video, outro_text])
        
        # Export final video
        final_video.write_videofile(
            output_path,
            fps=24,
            codec='libx264',
            audio_codec='aac',
            temp_audiofile='temp-audio.m4a',
            remove_temp=True,
            threads=4
        )
        
        print(f"Video created: {output_path}")
        
        # Cleanup
        for clip in self.source_videos:
            clip.close()
        
        return output_path

